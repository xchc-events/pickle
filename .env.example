# Copy to .env and fill in. Never commit .env — see .worktreeinclude for how it
# follows you into new git worktrees.

# Postgres. The devcontainer sets this for you; this value is for bare-metal local dev.
DATABASE_URL="postgresql://pickle:pickle@localhost:5432/pickle?schema=public"

# Auth.js. Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Signing in ---
# The one way in: a link emailed to the address on the account. Until both are
# set, the development role picker on /sign-in stands in — and those sessions
# are marked `authenticated: false`, so they cannot reveal payment details.
# resend.com → add and verify the sending domain → API keys.
AUTH_RESEND_KEY=""
# Must be on the verified sending domain, e.g. "XCHC <no-reply@send.minim.nz>".
EMAIL_FROM=""

# --- Payment details ---
# Seals the only two encrypted columns in the schema (bank account, IRD number).
# Generate with: openssl rand -base64 32
# Must decode to exactly 32 bytes. NOT RECOVERABLE — if this is lost, every
# payment detail on file has to be collected from the payee again.
PAYMENT_KEY=""

# --- File storage (Cloudflare R2) ---
# Riders, tech specs, press shots, artwork. Without these every other part of
# the app still works; uploads say storage is not configured rather than failing.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="pickle-files"

# --- Integrations (all optional until the relevant module is built) ---
# Gather.rsvp is the source of truth for ticketing.
GATHER_API_KEY=""
# Facebook Graph — event publishing.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# Eventbrite — inventory is capped so it cannot oversell.
EVENTBRITE_TOKEN=""
# Xero — invoices to 200, wage lines to 477, artist bills to 412.
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
