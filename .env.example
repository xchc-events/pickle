# Copy to .env and fill in. Never commit .env — see .worktreeinclude for how it
# follows you into new git worktrees.

# Postgres. The devcontainer sets this for you; this value is for bare-metal local dev.
DATABASE_URL="postgresql://pickle:pickle@localhost:5432/pickle?schema=public"

# Auth.js. Generate with: npx auth secret
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# --- Integrations (all optional until the relevant module is built) ---
# Gather.rsvp is the source of truth for ticketing.
GATHER_API_KEY=""
# Facebook Graph — event publishing.
FACEBOOK_APP_ID=""
FACEBOOK_APP_SECRET=""
# Eventbrite — inventory is capped so it cannot oversell.
EVENTBRITE_TOKEN=""
# Xero — invoices to 200, wage lines to 477, artist bills to 412.
XERO_CLIENT_ID=""
XERO_CLIENT_SECRET=""
