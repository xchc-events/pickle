// PicklePicklePickle — starting schema.
//
// The central claim of this product: one record of an event, one record of a
// person, one record of an hour. Every figure shown anywhere resolves back to
// hours logged against events and prices set on the event record.
//
// This schema covers the spine (people, events, hours, money, audit) plus the
// design and promotion modules. The remaining modules — ticketing detail, tech
// presets — hang off Event and are added as those modules are built.

// Two clients, from one schema, because the app now runs in two runtimes and
// Prisma 7 compiles queries with a WebAssembly module that each runtime loads
// differently. On Node the module is decoded from base64 and handed to
// `new WebAssembly.Module(...)`; workerd forbids compiling Wasm from bytes at
// runtime ("Wasm code generation disallowed by embedder") and takes it as a
// module import instead. The generator picks one or the other, so we ask for
// both and let the build choose — see the alias in next.config.ts.
//
// The old `prisma-client-js` generator could only do the Node form, which is
// why this moved to `prisma-client`; it is also the one Prisma 7 supports.
// `src/generated/` is gitignored and rebuilt by `npm run db:generate`.
generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

generator workerdClient {
  provider = "prisma-client"
  runtime  = "workerd"
  output   = "../src/generated/prisma-workerd"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- people ---

/// One record of a person. Renaming here changes them on every shift,
/// timesheet, run sheet and bar view at once — that is the point.
model Person {
  id       String  @id @default(cuid())
  name     String
  initials String  @unique
  email    String? @unique
  active   Boolean @default(true)
  /// Employee or contractor — decides which standard rate their hours cost
  /// the venue and pay them. See src/lib/finance.ts.
  employment Employment @default(CONTRACTOR)

  user         User?
  ownedEvents  Event[]       @relation("EventOwner")
  shifts       Shift[]
  hourEntries  HourEntry[]
  availability Availability?
  activity     Activity[]
  leads        EventLead[]
  channelPosts ChannelPush[]
  uploads      StoredFile[]
  grantsIssued AccessGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  COORDINATOR
  DESIGN
  TECH
  BAR
  ADMIN
  /// External coordinator — outside the venue. Sees only their own events.
  PROMOTER
}

/// Employee or contractor. See the standard rates on `CFG` in
/// src/lib/finance.ts — 22 Sep 2026 pay policy.
enum Employment {
  EMPLOYEE
  CONTRACTOR
}

/// An account. Permissions are enforced server-side off `role`; the sidebar
/// hiding a module is a convenience, never the control.
///
/// Made by an administrator in Admin and nowhere else — nothing on the
/// sign-in path can create one. See src/lib/auth.ts.
model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String?
  role     Role    @default(COORDINATOR)
  active   Boolean @default(true)

  // --- credentials ---
  //
  /// scrypt, in the PHC format src/lib/password.ts writes. Never the password.
  /// Null until the person sets one from an invitation or reset link — until
  /// then an emailed sign-in link is their only way in.
  passwordHash      String?
  passwordChangedAt DateTime?
  /// The last sign-in that succeeded, by either route. Shown in Admin, so an
  /// account nobody has used in months is visible as one.
  lastSignInAt      DateTime?

  // --- external promoters and curators ---
  //
  // People outside the venue are Users, not Persons. A Person carries shifts,
  // timesheets and availability; an outside coordinator has none of those, and
  // giving them one would put them in the roster's people list.
  /// Given and family name, kept apart because the venue writes to these
  /// people by name and "Awhina" is not the half you greet someone with.
  firstName String?
  lastName  String?
  phone     String?

  /// The organisation, label, collective, agency or brand this person acts
  /// for — and the whole of what they may see. `eventScope` matches
  /// `Event.promoterId` against exactly this, so a wrong value here is a
  /// disclosure rather than a display bug.
  ///
  /// Many users may share one organisation. That is the point: a label with
  /// three promoters gets three accounts and one set of shows.
  organisationId String?
  organisation   Payee?  @relation("OrgMembers", fields: [organisationId], references: [id])

  /// Superseded by `organisationId`. Kept for one release so the backfill can
  /// be checked against it, then dropped.
  promoter String?

  personId String? @unique
  person   Person? @relation(fields: [personId], references: [id])

  sessions   Session[]
  authTokens AuthToken[]
  authEvents AuthEvent[] @relation("AuthEventSubject")
  /// Things this account did to other accounts' access — invitations sent,
  /// sessions ended. Only ever an administrator.
  authActs   AuthEvent[] @relation("AuthEventActor")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// --------------------------------------------------------------- sign-in ---

/// How a session came to exist.
enum SignInMethod {
  PASSWORD
  /// A link emailed to the address on the account — sign-in, invitation or
  /// reset. Every one of them proves the inbox rather than a secret.
  EMAIL_LINK
}

/// A signed-in browser.
///
/// Stored in the database rather than in a signed cookie, so that it can be
/// taken back: switching somebody off in Admin, resetting a password, or
/// "sign out everywhere else" deletes rows, and the next request from those
/// browsers finds nothing. A JWT cannot be recalled that way.
///
/// Only the SHA-256 of the cookie's value is kept, as with `AccessGrant`. A
/// copy of this table is a list of who was signed in, not a way to be them.
model Session {
  id         String       @id @default(cuid())
  tokenHash  String       @unique
  userId     String
  user       User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  method     SignInMethod
  /// Browser and platform as the browser described itself, so a person can
  /// recognise "the bar laptop" in their own list. Display only; trivially
  /// forged, and never used to decide anything.
  userAgent  String?
  createdAt  DateTime     @default(now())
  /// Hard end: sign-in plus SESSION_MAX_DAYS, however much it is used.
  expires    DateTime
  /// Pushed forward at most hourly. A session unused for SESSION_IDLE_DAYS
  /// ends before `expires` does. See `sessionState` in src/lib/auth-rules.ts.
  lastSeenAt DateTime     @default(now())

  @@index([userId])
}

enum AuthTokenPurpose {
  /// Signs somebody in. One hour.
  SIGN_IN
  /// Sent by an administrator: set a first password. Seven days — it waits in
  /// an inbox for somebody who has not started yet.
  INVITE
  /// Asked for from "forgot your password": set a new one. One hour.
  RESET
}

/// A single-use link emailed to the address on an account.
///
/// The token is the credential, so it is handled like `AccessGrant`'s: 32
/// random bytes, only the SHA-256 stored, spent the first time it is used.
/// Issuing a new link deletes any unspent one of the same family — there is
/// only ever one live password link for an account, and it is the latest.
model AuthToken {
  id        String           @id @default(cuid())
  tokenHash String           @unique
  purpose   AuthTokenPurpose
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  expires   DateTime
  usedAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, purpose])
}

enum AuthEventKind {
  PASSWORD_SIGN_IN
  PASSWORD_FAILED
  LINK_SIGN_IN
  LINK_SENT
  INVITE_SENT
  RESET_SENT
  /// A first password, set from an invitation.
  PASSWORD_SET
  /// Set from a reset link.
  PASSWORD_RESET
  /// Changed from the account page, knowing the old one.
  PASSWORD_CHANGED
  SIGNED_OUT
  /// Somebody's sessions ended by something other than signing out: their own
  /// "sign out everywhere else", or an administrator.
  SESSIONS_ENDED
  /// The right credential for an account that has been switched off.
  REFUSED_INACTIVE
}

/// The sign-in audit trail.
///
/// Append-only, like `Activity`, and separate from it because `Activity`
/// belongs to an event and a sign-in belongs to nobody's event. Every attempt
/// that reaches a password check writes a row here, successful or not, and
/// the wrong-password throttle is counted from these rows rather than kept
/// anywhere else — so the thing that decides a lockout is also the record of
/// it.
///
/// `email` is the address as typed, normalised, whether or not it has an
/// account. That is what lets an address with no account be throttled exactly
/// like one with an account, so the throttle cannot be used to find out which
/// addresses are on file.
model AuthEvent {
  id        String        @id @default(cuid())
  kind      AuthEventKind
  email     String
  userId    String?
  user      User?         @relation("AuthEventSubject", fields: [userId], references: [id])
  /// Who did it, when that is not the account itself — an administrator
  /// sending an invitation or ending somebody's sessions.
  actorId   String?
  actor     User?         @relation("AuthEventActor", fields: [actorId], references: [id])
  /// The client address as reported by the proxy in front of the app.
  /// Forensics only: behind an unknown proxy it is whatever the client said.
  ip        String?
  userAgent String?
  at        DateTime      @default(now())

  @@index([email, at])
  @@index([userId, at])
}

/// Weekly hour cap, volunteer hours, and yes/no day-period preferences
/// keyed "Fri-eve", "Mon-day". Roster assignment is checked against this.
model Availability {
  id        String   @id @default(cuid())
  personId  String   @unique
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  weekly    Float    @default(0)
  volunteer Float    @default(0)
  yes       String[] @default([])
  no        String[] @default([])
}

/// Which modules each role can see. Mutated live from Admin.
model ModulePermission {
  role   Role
  module String

  @@id([role, module])
}

// ---------------------------------------------------------------- events ---

/// A bookable room.
///
/// Capacity lives here, on the row, rather than in constants keyed off the
/// room's name. It was in `CFG` and `capacityOf` matched the literal string
/// 'Apartment U1', so adding a room needed a code change and the column below
/// was read by nothing — two sources of truth with the editable one dead.
model Space {
  id       String  @id @default(cuid())
  name     String  @unique
  /// Standing capacity — the room as it is used most nights.
  capacity Int
  /// Seated capacity, used when the format is Cabaret. A separate column
  /// rather than a factor: seating a room is a layout decision the venue
  /// makes, not arithmetic on the standing figure.
  seatedCapacity Int @default(150)
  events   Event[]
  holds    Hold[]
}

/// Where a hold stands.
enum HoldState {
  HELD
  RELEASED
  /// This hold became the booking. At most one per room per night.
  CONFIRMED
}

/// A claim on a room for a night.
///
/// The venue had no availability model at all before this: an event carried
/// one date and one space and nothing checked whether the room was taken, so
/// two events could be booked into the same room on the same Saturday.
///
/// A hold belongs to an event and to one night, so a festival taking the room
/// for three days is three rows, and a second room is a fourth. Ranking is
/// right of first refusal — a 2nd hold challenges the 1st rather than booking
/// over it.
///
/// There is no expiry. The ladder is challenge-driven by decision: nothing
/// expires on a timer, so there is no background job and no hold that quietly
/// evaporates while a promoter believes they still have the room.
model Hold {
  id      String    @id @default(cuid())
  eventId String
  event   Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  spaceId String
  space   Space     @relation(fields: [spaceId], references: [id])
  /// The night held. An evening, not an instant — same reasoning as the run
  /// times on Event.
  date    DateTime
  /// 1 = first hold. Only meaningful while HELD; released rows keep their old
  /// number rather than being renumbered, so the history stays readable.
  rank    Int
  state   HoldState @default(HELD)
  /// The event waiting on this hold, once somebody has challenged it.
  challengedByEventId String?
  challengedAt        DateTime?
  releasedAt          DateTime?
  createdAt DateTime  @default(now())

  @@index([spaceId, date])
  @@index([eventId])
}

enum BookingModel {
  DRY
  CURATOR
}

/// Where the booking itself stands.
///
/// The only part of an event that is moved by hand. The other seven — design,
/// promo, tickets, licence, tech, roster, settlement — have no status column:
/// each is worked out from the records its own module keeps, so it cannot
/// disagree with them. See src/lib/parts.ts.
enum BookingStatus {
  ENQUIRY
  NEGOTIATING
  CONFIRMED
}

/// Severity of the reason an event is flagged on the pipeline.
enum RiskKind {
  WARN
  STOP
}

/// Where the terms with an outside promoter stand. SENT is the resting state
/// — the venue has put a deal to them and nobody has said anything back.
enum DealState {
  SENT
  AGREED
  QUERIED
}

enum TechStatus {
  DRAFT
  CONFIRMED
}

enum Licence {
  NOT_REQUIRED
  REQUIRED
  APPLIED_FOR
  CONFIRMED
  DENIED
}

/// The hub. Everything hangs off this record.
model Event {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  /// The date is still a best guess. `date` is always set so the event sorts
  /// into the calendar and the pipeline can count days to door, but the stage
  /// gate out of Enquiry treats it as unlocked until this clears.
  ///
  /// A nullable `date` would have been the other way to say this, and it was
  /// not taken: every read of the date would then need a null branch, to
  /// express something only the first stage cares about.
  dateTbc   Boolean  @default(false)
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id])
  kind      String
  /// Display label on the pipeline — "Live music", "DJs", "Cabaret", "DJs + live".
  /// `kind` drives behaviour; `format` is what the room is told it is.
  format    String  @default("DJs")
  ownerId   String?
  owner     Person? @relation("EventOwner", fields: [ownerId], references: [id])
  /// What the pipeline shows and what staff type — "Kōura Records",
  /// "internal · Ana Kelliher". Display only.
  ///
  /// It decides nothing about access. `promoterId` below is what `eventScope`
  /// matches on; this field was doing that job and let one organisation read
  /// another's shows by substring. See src/lib/scope.ts.
  promoter  String?
  /// The organisation that brought the show — who is paid, where their details
  /// live, and the only thing that scopes an external user to this event.
  promoterId String?
  promoterPayee Payee? @relation("EventPromoter", fields: [promoterId], references: [id])
  internal  Boolean  @default(false)

  /// Where the booking stands. Moving it on is gated — see `nextMove` in
  /// src/lib/parts.ts — and it only ever moves forward.
  bookingStatus      BookingStatus @default(ENQUIRY)
  /// When the booking reached its current status. Days-at-status derives from
  /// this — it is never stored, so it cannot go stale.
  bookingStatusSince DateTime      @default(now())

  /// Superseded by `bookingStatus` and the parts in src/lib/parts.ts, which
  /// gave every event a status per part in place of one stage it moved
  /// through in order. Kept for one release so the backfill can be checked
  /// against it, then dropped. Nothing reads or writes it.
  stage     Int          @default(0)
  /// Superseded with `stage`, by `bookingStatusSince`.
  stageEnteredAt DateTime @default(now())
  concluded Boolean      @default(false)
  model     BookingModel @default(CURATOR)
  licence   Licence      @default(NOT_REQUIRED)

  /// Where the terms with the promoter stand. The gate out of Negotiating
  /// requires AGREED, and QUERIED carries their words in `dealNote` so the
  /// coordinator reads the objection rather than a status.
  deal      DealState    @default(SENT)
  dealNote  String?

  /// Whether the tech lead has signed the plan off. Gates Rostering.
  techStatus TechStatus  @default(DRAFT)

  /// Why this event is flagged, in the coordinator's own words. Null means
  /// not at risk. The wording is shown verbatim on the pipeline row.
  riskNote  String?
  riskKind  RiskKind     @default(WARN)

  // --- ticketing inputs. Every tier derives from `std`. ---
  /// Standard price. sub = round(std * 0.8), sup = round(std * 1.2).
  std       Float @default(0)
  door      Float @default(0)
  /// [subsidised, standard, supporter, door] proportions. Must sum to 1.
  ///
  /// This order matches `avgTicket` in src/lib/finance.ts and the prototype's
  /// own TIER_KEYS. The handoff README's prose had it the other way round —
  /// now corrected there too. A supporter pays more than standard, not less.
  mix       Float[] @default([0.15, 0.5, 0.2, 0.15])
  /// Attendance by scenario: [quiet, likely, great].
  att       Int[]   @default([0, 0, 0])
  /// Which scenario the projection currently uses: 0 | 1 | 2.
  scen      Int     @default(1)
  sold      Int     @default(0)

  // --- run times ---
  /// Doors, bar close and everyone-out, as the venue says them: "8:00pm",
  /// "1:00am". Strings rather than DateTimes because these are a time of
  /// night, not an instant — an event moved to another week keeps its doors
  /// time, and nothing here should survive a timezone conversion.
  ///
  /// The ordering that matters is "is this after midnight", which
  /// `timeMinutes` in src/lib/event-record.ts answers by carrying the small
  /// hours past 1440. The licence gate hangs off it.
  doors     String?
  barClose  String?
  allOut    String?
  /// The amount of time the room is blocked out for, beyond doors and
  /// everyone-out: when the crew starts setting up, and when they are
  /// finished striking. Stored the same way — "3:00pm", "1:30am" — and
  /// just as free-standing; there is no rule tying one event's pack-out to
  /// another's pack-in. Connor, 23 Sep 2026: "We don't need a hard rule that
  /// says an event has to be packed out before another has packed in."
  packIn    String?
  packOut   String?
  /// The night it ends, stored the way `date` is (see src/lib/night.ts).
  ///
  /// `date` was the whole of when an event happens, which made a festival
  /// over a weekend impossible to say, and left "everyone out at 1:00am" to be
  /// understood as the next morning by a rule about the small hours. The rule
  /// stays for what still reads a bare time — the licence gate asks whether
  /// the bar runs past midnight — but when a night ends is now written down:
  /// the same date for an afternoon workshop, the next for a gig that runs
  /// past midnight, later for anything longer. Null while no end time is set.
  endDate   DateTime?

  // --- cost inputs ---
  barHead   Float  @default(0)
  gear      Float  @default(0)
  adv       Float  @default(0)
  /// "wheke" triggers the Wheke Sound sliding-scale fee.
  sound     String?
  /// Crew count and tokens per head, for the comps line.
  crew      Int    @default(0)
  tok       Int    @default(0)
  /// Share of surplus that goes to their people. 0–1.
  split     Float  @default(0)

  /// The creative one-liner, written once by the coordinator. Design reads it
  /// from here rather than from an email; null falls back to a line built out
  /// of the event's own facts. See src/lib/design.ts.
  brief     String?

  /// When each money milestone was raised, or null while it has not been.
  ///
  /// A timestamp rather than a boolean so "reverse" is a real event with a
  /// before and an after, and so the activity feed and the row agree about
  /// when the invoice went out. Which two milestones these are depends on the
  /// booking model — see `milestonesFor` in src/lib/finance-review.ts.
  depositRaisedAt DateTime?
  invoiceRaisedAt DateTime?

  artists     EventArtist[]
  shifts      Shift[]
  tasks       Task[]
  addons      Addon[]
  activity    Activity[]
  hours       HourEntry[]
  review      FinanceReview?
  actual      Actual?
  leads       EventLead[]
  assets      Asset[]
  channels    ChannelPush[]
  beats       Beat[]
  files       StoredFile[]
  grants      AccessGrant[]
  holds       Hold[]
  barBudget   BarBudget?
  barSales    BarSale[]
  ticketSales TicketSaleDay[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([bookingStatus])
  @@index([date])
  @@index([promoter])
  @@index([promoterId])
}

enum ArtistStatus {
  ENQUIRED
  PENCILLED
  CONFIRMED
  DECLINED
}

model EventArtist {
  id      String       @id @default(cuid())
  eventId String
  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name    String
  status  ArtistStatus @default(ENQUIRED)
  /// Fee floor and ceiling, agreed before the event can advance.
  low     Float        @default(0)
  high    Float        @default(0)
  /// The act as a record, carrying their payment details across every event
  /// they play. Null until somebody links them — `name` above is still what
  /// the pipeline shows, so an unlinked act is not a broken one.
  payeeId String?
  payee   Payee?       @relation(fields: [payeeId], references: [id])
  paid    Boolean      @default(false)
  order   Int          @default(0)

  @@index([payeeId])
}

enum ShiftState {
  OPEN
  ASKED
  ASSIGNED
  DONE
}

/// Roster ↔ Hours is two-way: assigning a shift creates the hours;
/// editing the hours reflects back here.
model Shift {
  id       String     @id @default(cuid())
  eventId  String
  event    Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  role     String
  hours    Float
  /// Offset in hours from doors, negative for set-up.
  start    Float      @default(0)
  personId String?
  person   Person?    @relation(fields: [personId], references: [id])
  state    ShiftState @default(OPEN)
  asked    Int        @default(0)

  hourEntry HourEntry?
}

model Task {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name    String
  est     Float  @default(0)
  actual  Float?
}

enum AddonKind {
  GEAR
  LABOUR
}

/// Tech rig presets append gear costs *and* labour hours, both of which flow
/// straight into the finance model.
model Addon {
  id      String    @id @default(cuid())
  eventId String
  event   Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind    AddonKind
  name    String
  cost    Float?
  hours   Float?
}

/// One record of an hour. Every wage figure resolves back to these.
///
/// Three kinds of row, told apart by what they hang off rather than by a
/// type column:
///
///  - `shiftId` set — an on-site hour, written by the roster when a shift was
///    assigned. Never typed by a person; see src/app/(app)/roster/actions.ts.
///  - `eventId` set, no shift — off-site work on a named event.
///  - neither set — org-wide work, pooled by month and apportioned across the
///    events in that month. This is what feeds `orgShareHours` in finance.ts.
model HourEntry {
  id       String  @id @default(cuid())
  personId String
  person   Person  @relation(fields: [personId], references: [id])
  eventId  String?
  event    Event?  @relation(fields: [eventId], references: [id])
  shiftId  String? @unique
  shift    Shift?  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  hours    Float
  /// Which team or org-wide role the hour belongs to. Kept as its own column
  /// rather than read out of `note`: the apportionment groups by it, and
  /// parsing a free-text note to work out where wages land is the kind of
  /// thing that breaks quietly.
  role     String?
  note     String?
  paid     Boolean @default(false)

  /// The day the work happened, which is not the day it was typed in. People
  /// log a fortnight late, and an October hour logged in November is October's
  /// — the monthly org-wide pool would otherwise land on the wrong events.
  workedOn DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([personId])
  @@index([eventId])
  @@index([workedOn])
}

/// Which department a person owns on an event. Ticketing, design, promo and
/// tech each get one lead; "unassigned" is the absence of a row, which is what
/// the stage gates test for.
enum LeadRole {
  TICKETING
  DESIGN
  PROMO
  TECH
}

/// One record of a person, here too: a lead is a Person, not a typed-in name,
/// so renaming them in Admin renames them on every brief and every chase.
model EventLead {
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  role     LeadRole
  personId String
  person   Person   @relation(fields: [personId], references: [id])

  @@id([eventId, role])
}

// ---------------------------------------------------------------- design ---

enum AssetState {
  DRAFT
  REVIEW
  APPROVED
}

/// One piece of artwork on an event's set.
///
/// The name, format spec, tier and rationale are house standard and live in
/// `ASSET_SET` in src/lib/design.ts — only `key` is stored here, so revising
/// what the house asks for revises it on every event at once rather than on
/// the events created after the change.
model Asset {
  id      String     @id @default(cuid())
  eventId String
  event   Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Key into ASSET_SET. Order and tier come from there.
  key     String
  state   AssetState @default(DRAFT)
  /// Hero and lead pieces also need the promoter's sign-off, given in their
  /// portal. Never set by the venue.
  promoterSigned Boolean @default(false)

  /// The artwork itself. A piece can carry more than one file — a print PDF
  /// and the flattened preview beside it — and keeps superseded versions.
  files StoredFile[]

  @@unique([eventId, key])
}

// ------------------------------------------------------------- promotion ---

/// Where an event has been listed, and by whom.
///
/// Name, icon, integration mode and blurb are house standard — `PLATFORMS` in
/// src/lib/promo.ts. What is stored here is only what happened to this event
/// on that channel.
model ChannelPush {
  id      String  @id @default(cuid())
  eventId String
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Key into PLATFORMS.
  channel String
  live    Boolean @default(false)
  /// The record changed after this went out, so the listing now disagrees
  /// with it. Only channels that mirror the record can go stale.
  stale   Boolean @default(false)
  note    String?
  /// Who ticked off a manual post. Auto-sync channels have nobody — the
  /// point of the distinction is that somebody is answerable for the others.
  byId    String?
  by      Person?   @relation(fields: [byId], references: [id])
  at      DateTime?

  @@unique([eventId, channel])
}

/// A beat in the promo plan. Name, timing and channel list are house standard
/// — `BEATS` in src/lib/promo.ts.
model Beat {
  id      String  @id @default(cuid())
  eventId String
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Key into BEATS.
  key     String
  done    Boolean @default(false)

  @@unique([eventId, key])
}

// ----------------------------------------------------------------- money ---

enum ReviewState {
  PENDING
  APPROVED
  FLAGGED
}

/// Sits before the deposit on dry hire, and at booking-confirmed on the
/// curator model. Red-flagging requires a reason.
model FinanceReview {
  id      String      @id @default(cuid())
  eventId String      @unique
  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  state   ReviewState @default(PENDING)
  note    String?
  by      String?
  when    DateTime?
}

/// Where a reconciled figure came from.
///
/// A POS-read figure and a typed one carry different authority, and a
/// settlement that cannot tell them apart cannot be audited. POS means read off
/// Epos Now, the venue's till, by the server; MANUAL means somebody typed it.
enum ActualSource {
  MANUAL
  POS
}

/// Once an event concludes, actuals replace projections.
///
/// Two halves, reconciled separately. The door is counted by the coordinator
/// off Gather.rsvp and the door sheet, on the event record; the bar is closed
/// by the bar manager off the till, in Bar. Until they were split the four
/// figures were one all-or-nothing row behind the Pipeline permission, so the
/// person holding the till read could not enter it.
///
/// A half is its two figures together or not at all — enforced by a CHECK
/// constraint in the migration, because Prisma cannot express one. The
/// settlement substitutes whichever halves are in and leaves the rest
/// projected; the gate out of Show week waits for both. See src/lib/actuals.ts.
model Actual {
  id         String @id @default(cuid())
  eventId    String @unique
  event      Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // --- the door ---
  /// People through the door, counted — not tickets sold.
  tickets    Int?
  /// Ticket takings, GST **inclusive**. `countedVals` divides by CFG.gst
  /// exactly as the projection does, so a counted night and a projected one
  /// stay comparable.
  ticketRev  Float?
  doorSource       ActualSource?
  /// Who counted it. Denormalised like `Activity.who`, so it keeps reading
  /// correctly for somebody who has since left.
  doorReconciledBy String?
  doorReconciledAt DateTime?

  // --- the bar ---
  /// Gross over the bar, GST **inclusive** — what the till took.
  barTake    Float?
  /// Bar profit after stock cost, GST **exclusive** — this goes onto the bar
  /// margin line untouched, so it must arrive in the same terms as `barMarg`.
  barProfit  Float?
  /// MANUAL when somebody typed the figures; POS when the server read them off
  /// Epos Now itself, in `closeBarFromTill`. A client can never claim POS for
  /// numbers it sent — that action takes no figures.
  barSource        ActualSource?
  barReconciledBy  String?
  barReconciledAt  DateTime?
}

// ------------------------------------------------------------------- bar ---
//
// The bar answers three questions: what do we think will happen, how did we
// actually do and why, and what does that mean for the months ahead. Epos Now
// — the venue's till — owns products, stock, orders and every sale, and its
// own Xero app sends bar sales to Xero. Nothing below orders stock or posts a
// sale; it is the budget, and the snapshot of a night's sales that explains
// the variance against it. See src/lib/bar.ts.

/// How a bar budget came to be locked.
enum BarBudgetBasis {
  /// Locked by the move to On sale — the normal case.
  ON_SALE
  /// Locked by hand for an event that was already on sale before bar budgets
  /// existed. It says so, so nobody mistakes it for what was believed then.
  LATE
}

/// What the bar was expected to do on a night, frozen when the event goes on
/// sale.
///
/// Locked rather than read live off the projection: a projection drifts
/// towards whatever happened as people edit the scenario, and a variance
/// measured against it shrinks to nothing. The figures are the settlement's
/// own bar line at the moment of locking, with the rates they were worked at,
/// so a later change to the model cannot rewrite what was believed. One per
/// event, and never updated.
model BarBudget {
  id           String         @id @default(cuid())
  eventId      String         @unique
  event        Event          @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// People expected through the door — the scenario the settlement read.
  heads        Int
  /// GST inclusive.
  spendPerHead Float
  /// Bar margin after stock, GST exclusive: `financeVals().barMarg` at lock.
  margin       Float
  stockCostPct Float
  /// Planned duty manager and bar staff hours.
  labourHours  Float
  loadedRate   Float
  basis        BarBudgetBasis @default(ON_SALE)
  /// Initials of whoever moved the event on sale, or locked it late.
  lockedBy     String?
  lockedAt     DateTime       @default(now())
}

/// One product's sales at a night's bar, read off Epos Now when the bar was
/// closed.
///
/// A snapshot that always matches the bar half the settlement reads: replaced
/// when the bar is closed off the till again, removed when it is closed by
/// hand. Epos Now stays the record of the sales; this is what the bar screen's
/// "why" is read from, without asking the till again every time it renders.
model BarSale {
  id            String  @id @default(cuid())
  eventId       String
  event         Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Epos Now's Product.Id. Null for an open-price sale with no product.
  eposProductId Int?
  name          String
  category      String?
  units         Float
  /// GST inclusive, after item discounts.
  revenue       Float
  revenueEx     Float
  /// GST exclusive. Zero when Epos Now held no cost price — see `costKnown`.
  cost          Float
  costKnown     Boolean

  @@index([eventId])
}

// ------------------------------------------------------------- tickets ---

/// One tier's ticket sales on one day, read from Gather.rsvp.
///
/// The sales graph on Ticketing draws a cumulative curve per tier, which
/// needs sales broken out by day rather than kept as one running total:
/// `sold` here is that day's tickets for that tier, not a total. `Event.sold`
/// stays the current total pulled onto the event record; this table is its
/// history, and the seed writes both from the same figures so they cannot
/// disagree. `salesHistory` in src/lib/gather.ts is the only reader, standing
/// in for the real "orders" read (docs/gather-rsvp-api.md, section 3.2) that
/// replaces it once a real client exists.
model TicketSaleDay {
  id      String   @id @default(cuid())
  eventId String
  event   Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  day     DateTime
  /// sub | std | sup | door — MixKey in src/lib/ticketing.ts.
  tier    String
  sold    Int

  @@unique([eventId, day, tier])
}

// ---------------------------------------------------------------- payees ---

enum PayeeKind {
  /// An act. Linked from EventArtist, once per act rather than once per show.
  ARTIST
  /// An outside promoter's organisation.
  PROMOTER
}

/// Somebody XCHC pays.
///
/// One record of a person, applied to the people who are not staff: an act
/// that plays four times enters their account number once, and correcting it
/// corrects it on every settlement that has not yet gone out.
///
/// `bankEnc` and `irdEnc` are the only encrypted columns in this schema —
/// AES-256-GCM, sealed and opened in src/lib/secrets.ts, keyed from
/// PAYMENT_KEY which appears nowhere in this repository. The matching `*Tail`
/// columns hold the last three digits in the clear so Finance can tell two
/// accounts apart on screen without either one being decrypted.
model Payee {
  id      String    @id @default(cuid())
  kind    PayeeKind
  name    String
  email   String?
  phone   String?
  /// ISO country of tax residence. Anything other than NZ withholds — see
  /// `withholdingRate` in src/lib/bank.ts.
  country String    @default("NZ")

  /// Sealed NZ bank account, 16 digits normalised. Null until they fill it in.
  bankEnc     Bytes?
  /// Last three digits of the account body. Never enough to reconstruct it.
  bankTail    String?
  /// Account holder name as it appears at the bank. Not secret, and needed
  /// to spot the mismatch that makes a payment bounce.
  bankName    String?
  /// Sealed IRD number, nine digits normalised.
  irdEnc      Bytes?
  irdTail     String?
  gstReg      Boolean   @default(false)
  gstNumber   String?
  /// Agreed non-resident contractor rate, 0–1. Null falls back to the
  /// standard rate for a non-NZ payee, which is the safe direction.
  nrctRate    Float?
  /// Whether a current certificate of exemption has been sighted.
  nrctExempt  Boolean   @default(false)
  /// When the payee last confirmed these details are current. Null means
  /// never — the details came from somewhere other than the payee.
  detailsAt   DateTime?

  artists EventArtist[]
  events  Event[]       @relation("EventPromoter")
  /// The people who act for this organisation. Empty for an artist payee.
  members User[]        @relation("OrgMembers")
  files   StoredFile[]
  grants  AccessGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, name])
}

// ----------------------------------------------------------------- files ---

enum FileKind {
  RIDER_HOSPITALITY
  RIDER_TECH
  STAGE_PLOT
  TECH_SPEC
  PRESS_SHOT
  BIO
  EPK
  /// A finished piece of the house asset set. Links to an Asset row.
  ARTWORK
  /// Brand marks and templates that belong to the venue, not to one event.
  BRAND
  OTHER
}

enum ScanState {
  PENDING
  CLEAN
  BLOCKED
}

/// One uploaded file, stored in R2 and described here.
///
/// The bytes never pass through the application: the browser PUTs them
/// straight to a presigned URL and reads them back from a presigned GET, so
/// a 100MB video cut is not a 100MB request against the Next server.
///
/// `key` is opaque and randomly generated — never derived from the uploader's
/// filename, which is theirs to choose and would otherwise let them write
/// across another event's prefix.
model StoredFile {
  id     String    @id @default(cuid())
  /// Object key in the bucket. Unique, unguessable, never reused.
  key    String    @unique
  /// The filename the uploader gave it. Display only; never a path.
  name   String
  mime   String
  size   Int
  /// Content hash, so the same rider uploaded twice is recognisable as one
  /// file rather than two.
  sha256 String
  kind   FileKind
  /// Files arriving from outside the venue are not served until they have
  /// been through a scan. See src/lib/files.ts.
  scan   ScanState @default(PENDING)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payeeId String?
  payee   Payee?  @relation(fields: [payeeId], references: [id], onDelete: Cascade)
  /// Set when this file is a piece of the house asset set.
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// Who put it there. Null when it came in through a grant, in which case
  /// `grantId` names the link it arrived on.
  uploadedById String?
  uploadedBy   Person?      @relation(fields: [uploadedById], references: [id])
  grantId      String?
  grant        AccessGrant? @relation(fields: [grantId], references: [id])

  /// Replacing a rider supersedes the old one rather than overwriting it —
  /// the tech who printed last week's copy needs to know it changed.
  version   Int     @default(1)
  current   Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([eventId, kind])
  @@index([payeeId, kind])
  @@index([assetId])
}

// ---------------------------------------------------------------- access ---

enum GrantScope {
  /// Bank and tax details only.
  PAYMENT_DETAILS
  /// Riders, stage plots, press shots.
  RIDER
  BOTH
}

/// A link that lets somebody outside the venue put their own details in.
///
/// Touring acts are not staff and will not have accounts. They get a signed,
/// single-use link that reaches exactly one payee's form and nothing else.
///
/// Only the SHA-256 of the token is stored. The token itself is shown once,
/// at the moment it is created, and cannot be recovered afterwards — a
/// database read therefore does not hand over working links.
model AccessGrant {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  scope     GrantScope
  payeeId   String
  payee     Payee      @relation(fields: [payeeId], references: [id], onDelete: Cascade)
  /// The event the link was sent about. Scopes what the form shows; the
  /// payment details themselves belong to the payee, not to the event.
  eventId   String?
  event     Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  expires   DateTime
  /// Set the first time the link is used. A grant is not spent on use — the
  /// artist may come back to correct a typo — but a first use that the
  /// artist did not make is the signal that the link went astray.
  usedAt    DateTime?
  revokedAt DateTime?

  createdById String?
  createdBy   Person?  @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  files StoredFile[]

  @@index([payeeId])
  @@index([expires])
}

// ----------------------------------------------------------------- audit ---

/// Append-only. Every mutation writes here; nothing updates or deletes.
/// This is the audit trail — enforce insert-only at the database role level.
model Activity {
  id       String   @id @default(cuid())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId String?
  person   Person?  @relation(fields: [personId], references: [id])
  who      String
  text     String
  at       DateTime @default(now())

  @@index([eventId, at])
}
