// PicklePicklePickle — starting schema.
//
// The central claim of this product: one record of an event, one record of a
// person, one record of an hour. Every figure shown anywhere resolves back to
// hours logged against events and prices set on the event record.
//
// This schema covers the spine (people, events, hours, money, audit) plus the
// design and promotion modules. The remaining modules — ticketing detail, tech
// presets — hang off Event and are added as those modules are built.

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------- people ---

/// One record of a person. Renaming here changes them on every shift,
/// timesheet, run sheet and bar view at once — that is the point.
model Person {
  id       String  @id @default(cuid())
  name     String
  initials String  @unique
  email    String? @unique
  active   Boolean @default(true)

  user         User?
  ownedEvents  Event[]       @relation("EventOwner")
  shifts       Shift[]
  hourEntries  HourEntry[]
  availability Availability?
  activity     Activity[]
  leads        EventLead[]
  channelPosts ChannelPush[]
  uploads      StoredFile[]
  grantsIssued AccessGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum Role {
  COORDINATOR
  DESIGN
  TECH
  BAR
  ADMIN
  /// External coordinator — outside the venue. Sees only their own events.
  PROMOTER
}

/// Auth.js account. Permissions are enforced server-side off `role`; the
/// sidebar hiding a module is a convenience, never the control.
model User {
  id       String  @id @default(cuid())
  email    String  @unique
  name     String?
  image    String?
  role     Role    @default(COORDINATOR)
  /// Set for PROMOTER users — scopes every query to this promoter's events.
  promoter String?
  active   Boolean @default(true)

  personId String? @unique
  person   Person? @relation(fields: [personId], references: [id])

  emailVerified DateTime?
  accounts      Account[]
  sessions      Session[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

/// Weekly hour cap, volunteer hours, and yes/no day-period preferences
/// keyed "Fri-eve", "Mon-day". Roster assignment is checked against this.
model Availability {
  id        String   @id @default(cuid())
  personId  String   @unique
  person    Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  weekly    Float    @default(0)
  volunteer Float    @default(0)
  yes       String[] @default([])
  no        String[] @default([])
}

/// Which modules each role can see. Mutated live from Admin.
model ModulePermission {
  role   Role
  module String

  @@id([role, module])
}

// ---------------------------------------------------------------- events ---

model Space {
  id       String  @id @default(cuid())
  name     String  @unique
  capacity Int
  events   Event[]
}

enum BookingModel {
  DRY
  CURATOR
}

/// Severity of the reason an event is flagged on the pipeline.
enum RiskKind {
  WARN
  STOP
}

enum Licence {
  NOT_REQUIRED
  REQUIRED
  APPLIED_FOR
  CONFIRMED
  DENIED
}

/// The hub. Everything hangs off this record.
model Event {
  id        String   @id @default(cuid())
  name      String
  date      DateTime
  spaceId   String
  space     Space    @relation(fields: [spaceId], references: [id])
  kind      String
  /// Display label on the pipeline — "Live music", "DJs", "Cabaret", "DJs + live".
  /// `kind` drives behaviour; `format` is what the room is told it is.
  format    String  @default("DJs")
  ownerId   String?
  owner     Person? @relation("EventOwner", fields: [ownerId], references: [id])
  /// Set when an outside promoter brings the show. Scopes portal access.
  ///
  /// Still the free-text name `eventScope()` matches on. `promoterId` below
  /// is the record it should resolve to; the two live side by side until the
  /// scope rule is migrated onto the relation, which is a permissions change
  /// and gets its own tests rather than riding along with this one.
  promoter  String?
  /// The promoter as a record — who is paid, and where their details live.
  promoterId String?
  promoterPayee Payee? @relation("EventPromoter", fields: [promoterId], references: [id])
  internal  Boolean  @default(false)

  /// 0 enquiry … 7 settled. Transitions are gated — see src/lib/gates.ts.
  stage     Int          @default(0)
  /// When the event entered its current stage. Days-in-stage derives from
  /// this — it is never stored, so it cannot go stale.
  stageEnteredAt DateTime @default(now())
  concluded Boolean      @default(false)
  model     BookingModel @default(CURATOR)
  licence   Licence      @default(NOT_REQUIRED)

  /// Why this event is flagged, in the coordinator's own words. Null means
  /// not at risk. The wording is shown verbatim on the pipeline row.
  riskNote  String?
  riskKind  RiskKind     @default(WARN)

  // --- ticketing inputs. Every tier derives from `std`. ---
  /// Standard price. sub = round(std * 0.8), sup = round(std * 1.2).
  std       Float @default(0)
  door      Float @default(0)
  /// [subsidised, standard, supporter, door] proportions. Must sum to 1.
  ///
  /// This order matches `avgTicket` in src/lib/finance.ts and the prototype's
  /// own TIER_KEYS. The handoff README's prose has it the other way round and
  /// is wrong — a supporter pays more than standard, not less.
  mix       Float[] @default([0.15, 0.5, 0.2, 0.15])
  /// Attendance by scenario: [quiet, likely, great].
  att       Int[]   @default([0, 0, 0])
  /// Which scenario the projection currently uses: 0 | 1 | 2.
  scen      Int     @default(1)
  sold      Int     @default(0)

  // --- cost inputs ---
  barHead   Float  @default(0)
  barClose  String?
  gear      Float  @default(0)
  adv       Float  @default(0)
  /// "wheke" triggers the Wheke Sound sliding-scale fee.
  sound     String?
  /// Crew count and tokens per head, for the comps line.
  crew      Int    @default(0)
  tok       Int    @default(0)
  /// Share of surplus that goes to their people. 0–1.
  split     Float  @default(0)

  /// The creative one-liner, written once by the coordinator. Design reads it
  /// from here rather than from an email; null falls back to a line built out
  /// of the event's own facts. See src/lib/design.ts.
  brief     String?

  artists   EventArtist[]
  shifts    Shift[]
  tasks     Task[]
  addons    Addon[]
  activity  Activity[]
  hours     HourEntry[]
  review    FinanceReview?
  actual    Actual?
  leads     EventLead[]
  assets    Asset[]
  channels  ChannelPush[]
  beats     Beat[]
  files     StoredFile[]
  grants    AccessGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([stage])
  @@index([date])
  @@index([promoter])
  @@index([promoterId])
}

enum ArtistStatus {
  ENQUIRED
  PENCILLED
  CONFIRMED
  DECLINED
}

model EventArtist {
  id      String       @id @default(cuid())
  eventId String
  event   Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name    String
  status  ArtistStatus @default(ENQUIRED)
  /// Fee floor and ceiling, agreed before the event can advance.
  low     Float        @default(0)
  high    Float        @default(0)
  /// The act as a record, carrying their payment details across every event
  /// they play. Null until somebody links them — `name` above is still what
  /// the pipeline shows, so an unlinked act is not a broken one.
  payeeId String?
  payee   Payee?       @relation(fields: [payeeId], references: [id])
  paid    Boolean      @default(false)
  order   Int          @default(0)

  @@index([payeeId])
}

enum ShiftState {
  OPEN
  ASKED
  ASSIGNED
  DONE
}

/// Roster ↔ Hours is two-way: assigning a shift creates the hours;
/// editing the hours reflects back here.
model Shift {
  id       String     @id @default(cuid())
  eventId  String
  event    Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  role     String
  hours    Float
  /// Offset in hours from doors, negative for set-up.
  start    Float      @default(0)
  personId String?
  person   Person?    @relation(fields: [personId], references: [id])
  state    ShiftState @default(OPEN)
  asked    Int        @default(0)

  hourEntry HourEntry?
}

model Task {
  id      String @id @default(cuid())
  eventId String
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  name    String
  est     Float  @default(0)
  actual  Float?
}

enum AddonKind {
  GEAR
  LABOUR
}

/// Tech rig presets append gear costs *and* labour hours, both of which flow
/// straight into the finance model.
model Addon {
  id      String    @id @default(cuid())
  eventId String
  event   Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  kind    AddonKind
  name    String
  cost    Float?
  hours   Float?
}

/// One record of an hour. Every wage figure resolves back to these.
///
/// Three kinds of row, told apart by what they hang off rather than by a
/// type column:
///
///  - `shiftId` set — an on-site hour, written by the roster when a shift was
///    assigned. Never typed by a person; see src/app/(app)/roster/actions.ts.
///  - `eventId` set, no shift — off-site work on a named event.
///  - neither set — org-wide work, pooled by month and apportioned across the
///    events in that month. This is what feeds `orgShareHours` in finance.ts.
model HourEntry {
  id       String  @id @default(cuid())
  personId String
  person   Person  @relation(fields: [personId], references: [id])
  eventId  String?
  event    Event?  @relation(fields: [eventId], references: [id])
  shiftId  String? @unique
  shift    Shift?  @relation(fields: [shiftId], references: [id], onDelete: Cascade)
  hours    Float
  /// Which team or org-wide role the hour belongs to. Kept as its own column
  /// rather than read out of `note`: the apportionment groups by it, and
  /// parsing a free-text note to work out where wages land is the kind of
  /// thing that breaks quietly.
  role     String?
  note     String?
  paid     Boolean @default(false)

  /// The day the work happened, which is not the day it was typed in. People
  /// log a fortnight late, and an October hour logged in November is October's
  /// — the monthly org-wide pool would otherwise land on the wrong events.
  workedOn DateTime @default(now())

  createdAt DateTime @default(now())

  @@index([personId])
  @@index([eventId])
  @@index([workedOn])
}

/// Which department a person owns on an event. Ticketing, design, promo and
/// tech each get one lead; "unassigned" is the absence of a row, which is what
/// the stage gates test for.
enum LeadRole {
  TICKETING
  DESIGN
  PROMO
  TECH
}

/// One record of a person, here too: a lead is a Person, not a typed-in name,
/// so renaming them in Admin renames them on every brief and every chase.
model EventLead {
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  role     LeadRole
  personId String
  person   Person   @relation(fields: [personId], references: [id])

  @@id([eventId, role])
}

// ---------------------------------------------------------------- design ---

enum AssetState {
  DRAFT
  REVIEW
  APPROVED
}

/// One piece of artwork on an event's set.
///
/// The name, format spec, tier and rationale are house standard and live in
/// `ASSET_SET` in src/lib/design.ts — only `key` is stored here, so revising
/// what the house asks for revises it on every event at once rather than on
/// the events created after the change.
model Asset {
  id      String     @id @default(cuid())
  eventId String
  event   Event      @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Key into ASSET_SET. Order and tier come from there.
  key     String
  state   AssetState @default(DRAFT)
  /// Hero and lead pieces also need the promoter's sign-off, given in their
  /// portal. Never set by the venue.
  promoterSigned Boolean @default(false)

  /// The artwork itself. A piece can carry more than one file — a print PDF
  /// and the flattened preview beside it — and keeps superseded versions.
  files StoredFile[]

  @@unique([eventId, key])
}

// ------------------------------------------------------------- promotion ---

/// Where an event has been listed, and by whom.
///
/// Name, icon, integration mode and blurb are house standard — `PLATFORMS` in
/// src/lib/promo.ts. What is stored here is only what happened to this event
/// on that channel.
model ChannelPush {
  id      String  @id @default(cuid())
  eventId String
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Key into PLATFORMS.
  channel String
  live    Boolean @default(false)
  /// The record changed after this went out, so the listing now disagrees
  /// with it. Only channels that mirror the record can go stale.
  stale   Boolean @default(false)
  note    String?
  /// Who ticked off a manual post. Auto-sync channels have nobody — the
  /// point of the distinction is that somebody is answerable for the others.
  byId    String?
  by      Person?   @relation(fields: [byId], references: [id])
  at      DateTime?

  @@unique([eventId, channel])
}

/// A beat in the promo plan. Name, timing and channel list are house standard
/// — `BEATS` in src/lib/promo.ts.
model Beat {
  id      String  @id @default(cuid())
  eventId String
  event   Event   @relation(fields: [eventId], references: [id], onDelete: Cascade)
  /// Key into BEATS.
  key     String
  done    Boolean @default(false)

  @@unique([eventId, key])
}

// ----------------------------------------------------------------- money ---

enum ReviewState {
  PENDING
  APPROVED
  FLAGGED
}

/// Sits before the deposit on dry hire, and at booking-confirmed on the
/// curator model. Red-flagging requires a reason.
model FinanceReview {
  id      String      @id @default(cuid())
  eventId String      @unique
  event   Event       @relation(fields: [eventId], references: [id], onDelete: Cascade)
  state   ReviewState @default(PENDING)
  note    String?
  by      String?
  when    DateTime?
}

/// Once an event concludes, actuals replace projections.
model Actual {
  id         String @id @default(cuid())
  eventId    String @unique
  event      Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  tickets    Int    @default(0)
  ticketRev  Float  @default(0)
  barTake    Float  @default(0)
  barProfit  Float  @default(0)
}

// ---------------------------------------------------------------- payees ---

enum PayeeKind {
  /// An act. Linked from EventArtist, once per act rather than once per show.
  ARTIST
  /// An outside promoter's organisation.
  PROMOTER
}

/// Somebody XCHC pays.
///
/// One record of a person, applied to the people who are not staff: an act
/// that plays four times enters their account number once, and correcting it
/// corrects it on every settlement that has not yet gone out.
///
/// `bankEnc` and `irdEnc` are the only encrypted columns in this schema —
/// AES-256-GCM, sealed and opened in src/lib/secrets.ts, keyed from
/// PAYMENT_KEY which appears nowhere in this repository. The matching `*Tail`
/// columns hold the last three digits in the clear so Finance can tell two
/// accounts apart on screen without either one being decrypted.
model Payee {
  id      String    @id @default(cuid())
  kind    PayeeKind
  name    String
  email   String?
  phone   String?
  /// ISO country of tax residence. Anything other than NZ withholds — see
  /// `withholdingRate` in src/lib/bank.ts.
  country String    @default("NZ")

  /// Sealed NZ bank account, 16 digits normalised. Null until they fill it in.
  bankEnc     Bytes?
  /// Last three digits of the account body. Never enough to reconstruct it.
  bankTail    String?
  /// Account holder name as it appears at the bank. Not secret, and needed
  /// to spot the mismatch that makes a payment bounce.
  bankName    String?
  /// Sealed IRD number, nine digits normalised.
  irdEnc      Bytes?
  irdTail     String?
  gstReg      Boolean   @default(false)
  gstNumber   String?
  /// Agreed non-resident contractor rate, 0–1. Null falls back to the
  /// standard rate for a non-NZ payee, which is the safe direction.
  nrctRate    Float?
  /// Whether a current certificate of exemption has been sighted.
  nrctExempt  Boolean   @default(false)
  /// When the payee last confirmed these details are current. Null means
  /// never — the details came from somewhere other than the payee.
  detailsAt   DateTime?

  artists EventArtist[]
  events  Event[]       @relation("EventPromoter")
  files   StoredFile[]
  grants  AccessGrant[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind, name])
}

// ----------------------------------------------------------------- files ---

enum FileKind {
  RIDER_HOSPITALITY
  RIDER_TECH
  STAGE_PLOT
  TECH_SPEC
  PRESS_SHOT
  BIO
  EPK
  /// A finished piece of the house asset set. Links to an Asset row.
  ARTWORK
  /// Brand marks and templates that belong to the venue, not to one event.
  BRAND
  OTHER
}

enum ScanState {
  PENDING
  CLEAN
  BLOCKED
}

/// One uploaded file, stored in R2 and described here.
///
/// The bytes never pass through the application: the browser PUTs them
/// straight to a presigned URL and reads them back from a presigned GET, so
/// a 100MB video cut is not a 100MB request against the Next server.
///
/// `key` is opaque and randomly generated — never derived from the uploader's
/// filename, which is theirs to choose and would otherwise let them write
/// across another event's prefix.
model StoredFile {
  id     String    @id @default(cuid())
  /// Object key in the bucket. Unique, unguessable, never reused.
  key    String    @unique
  /// The filename the uploader gave it. Display only; never a path.
  name   String
  mime   String
  size   Int
  /// Content hash, so the same rider uploaded twice is recognisable as one
  /// file rather than two.
  sha256 String
  kind   FileKind
  /// Files arriving from outside the venue are not served until they have
  /// been through a scan. See src/lib/files.ts.
  scan   ScanState @default(PENDING)

  eventId String?
  event   Event?  @relation(fields: [eventId], references: [id], onDelete: Cascade)
  payeeId String?
  payee   Payee?  @relation(fields: [payeeId], references: [id], onDelete: Cascade)
  /// Set when this file is a piece of the house asset set.
  assetId String?
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade)

  /// Who put it there. Null when it came in through a grant, in which case
  /// `grantId` names the link it arrived on.
  uploadedById String?
  uploadedBy   Person?      @relation(fields: [uploadedById], references: [id])
  grantId      String?
  grant        AccessGrant? @relation(fields: [grantId], references: [id])

  /// Replacing a rider supersedes the old one rather than overwriting it —
  /// the tech who printed last week's copy needs to know it changed.
  version   Int     @default(1)
  current   Boolean @default(true)

  createdAt DateTime @default(now())

  @@index([eventId, kind])
  @@index([payeeId, kind])
  @@index([assetId])
}

// ---------------------------------------------------------------- access ---

enum GrantScope {
  /// Bank and tax details only.
  PAYMENT_DETAILS
  /// Riders, stage plots, press shots.
  RIDER
  BOTH
}

/// A link that lets somebody outside the venue put their own details in.
///
/// Touring acts are not staff and will not have accounts. They get a signed,
/// single-use link that reaches exactly one payee's form and nothing else.
///
/// Only the SHA-256 of the token is stored. The token itself is shown once,
/// at the moment it is created, and cannot be recovered afterwards — a
/// database read therefore does not hand over working links.
model AccessGrant {
  id        String     @id @default(cuid())
  tokenHash String     @unique
  scope     GrantScope
  payeeId   String
  payee     Payee      @relation(fields: [payeeId], references: [id], onDelete: Cascade)
  /// The event the link was sent about. Scopes what the form shows; the
  /// payment details themselves belong to the payee, not to the event.
  eventId   String?
  event     Event?     @relation(fields: [eventId], references: [id], onDelete: Cascade)

  expires   DateTime
  /// Set the first time the link is used. A grant is not spent on use — the
  /// artist may come back to correct a typo — but a first use that the
  /// artist did not make is the signal that the link went astray.
  usedAt    DateTime?
  revokedAt DateTime?

  createdById String?
  createdBy   Person?  @relation(fields: [createdById], references: [id])
  createdAt   DateTime @default(now())

  files StoredFile[]

  @@index([payeeId])
  @@index([expires])
}

// ----------------------------------------------------------------- audit ---

/// Append-only. Every mutation writes here; nothing updates or deletes.
/// This is the audit trail — enforce insert-only at the database role level.
model Activity {
  id       String   @id @default(cuid())
  eventId  String
  event    Event    @relation(fields: [eventId], references: [id], onDelete: Cascade)
  personId String?
  person   Person?  @relation(fields: [personId], references: [id])
  who      String
  text     String
  at       DateTime @default(now())

  @@index([eventId, at])
}
